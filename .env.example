# Copier ce fichier vers .env. Ne jamais publier .env.
PORT=3087
HOST=127.0.0.1
HAI_API_KEY=
HAI_API_BASE=https://agp.eu.hcompany.ai/api/v2
HAI_AGENT=h/web-surfer-flash
# Pour le navigateur cloud H : URL HTTPS publique de CETTE application.
# Exemple après déploiement HF : https://votre-compte-checkout-proof.hf.space
PUBLIC_BASE_URL=
# Obligatoire si PUBLIC_BASE_URL est défini. Protège le tableau de bord et ses API.
# HTTP Basic : nom d’utilisateur libre, mot de passe = cette valeur.
DASHBOARD_TOKEN=
H_MAX_STEPS=45
H_MAX_TIME_S=180
# Facultatif, si vous enregistrez les deux rôles dans votre compte H :
# HAI_AGENT=checkoutproof-testeur-j2
# HAI_ANALYST_AGENT=checkoutproof-analyste-j2

# false : chaque nouveau test s’arrête explicitement avant paiement.
PAYMENT_SIMULATION_ENABLED=true
